# Copy to .env. Every setting the service reads is listed here. No API keys are needed.

# --- infrastructure ---
DATABASE_URL=postgresql://music:music@localhost:5432/music
S3_ENDPOINT=http://localhost:9000
# host that clients use for presigned links (your public domain in production)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=music
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
PRESIGN_TTL_S=86400

# --- api ---
# empty disables auth (local only); set a long random string for any shared deployment
API_TOKEN=
RATE_LIMIT_PER_MIN=30
MAX_QUEUE=50

# --- worker ---
WORKER_CONCURRENCY=2
JOB_TIMEOUT_S=900
MAX_ATTEMPTS=3
HEARTBEAT_STALE_S=60
POLL_INTERVAL_S=0.5

# --- renderer: fluidsynth | numpy | mock ---
RENDERER=fluidsynth
RENDERER_FALLBACK=numpy
FLUIDSYNTH_BIN=fluidsynth
FLUIDSYNTH_TIMEOUT_S=120
SOUNDFONT_PATH=/opt/soundfonts/FluidR3_GM.sf2
FFMPEG_BIN=ffmpeg

# --- prompt interpreter: rules | llm | mock ---
INTERPRETER=rules
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# optional; only used when INTERPRETER=llm
LLM_API_KEY=
LLM_TIMEOUT_S=15

# --- callbacks ---
CALLBACK_SECRET=change-me
CALLBACK_TIMEOUT_S=5

# --- music rules ---
MIN_SECTION_GAP_S=1.5
MIN_DURATION_S=5
MAX_DURATION_S=300
TARGET_LUFS_DEFAULT=-16
TP_CEILING_DBTP=-1.5
LUFS_TOL=0.5
DUCK_DB=12
DUCK_ATTACK_MS=120
DUCK_RELEASE_MS=500
DUCK_BRIDGE_GAP_S=0.6
MAX_NARRATION_MB=50
NARRATION_FETCH_TIMEOUT_S=20
# SSRF guard: narration_url / callback_url may not resolve to private, loopback or metadata IPs
ALLOW_PRIVATE_URLS=false

# --- cost model: your server's $ per vCPU-second ---
COST_PER_CPU_SECOND=0.0000134

# test only: render_primary_fail | render_timeout | llm_fail
FAULT_INJECT=
LOG_LEVEL=INFO
